# =============================================================================
# CloudMLOps - AI Document Summarization Platform
# Copy this file to .env and adjust the values for your environment.
# NEVER commit a real .env file.
# =============================================================================

# ---- Application ----
APP_NAME=CloudMLOps Document Summarizer
ENVIRONMENT=development
LOG_LEVEL=INFO
# Human readable JSON logs are easier to ship to CloudWatch; set to false locally.
LOG_JSON=false

# ---- Database ----
# Local (docker compose) PostgreSQL
DATABASE_URL=postgresql+psycopg://cloudmlops:cloudmlops@localhost:5432/cloudmlops
# On AWS this becomes the RDS endpoint, e.g.
# DATABASE_URL=postgresql+psycopg://admin:<password>@<rds-endpoint>:5432/cloudmlops

# Schema management. Alembic owns the schema; create_all is a convenience for
# running the app straight from a checkout without the CLI.
#   AUTO_CREATE_SCHEMA=true  -> create missing tables on startup (development)
#   AUTO_CREATE_SCHEMA=false -> `alembic upgrade head` (Docker, CI, production)
AUTO_CREATE_SCHEMA=true
# Honoured by the container entrypoint, not by the app itself.
RUN_MIGRATIONS=true

# ---- Security / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production-use-a-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- CORS (comma separated) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Rate limiting (brute-force protection, counted per client IP) ----
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=3600

# ---- File uploads ----
# local -> filesystem under STORAGE_DIR (development, docker compose)
# s3    -> Amazon S3; required on App Runner, whose disk is ephemeral and
#          per instance. Needs `pip install -r requirements-aws.txt`.
STORAGE_BACKEND=local
STORAGE_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=10
# S3_BUCKET=cloudmlops-uploads
# S3_PREFIX=documents
# S3_REGION=us-east-1

# ---- AI model ----
# auto      -> use FLAN-T5 if transformers/torch are installed, else extractive fallback
# flan-t5   -> require the transformers model (fails loudly if unavailable)
# extractive-> always use the lightweight extractive summarizer (fast, no torch)
AI_BACKEND=auto
AI_MODEL_NAME=google/flan-t5-small
AI_MODEL_CACHE_DIR=hf_cache
# Guard rails so a single huge document cannot exhaust the container
AI_MAX_INPUT_CHARS=60000
AI_CHUNK_TOKENS=420

# ---- First admin account (seeded on startup when SEED_ADMIN=true) ----
SEED_ADMIN=true
# Must use a real TLD - reserved names like ".local" fail email validation.
ADMIN_EMAIL=admin@cloudmlops.app
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Platform Administrator

# ---- Frontend ----
# Leave empty for Docker Compose and `npm run dev` (both proxy /api automatically).
# Set only when the API is on a different host, e.g. an App Runner URL in production.
# VITE_API_BASE_URL=
